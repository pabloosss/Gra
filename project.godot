; Engine configuration file.
; Godot 4.7.2

config_version=5

[application]
config/name="Gra Pixel DnD"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")

[display/window]
size/viewport_width=640
size/viewport_height=360
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

environment/defaults/default_clear_color=Color(0.027, 0.035, 0.067, 1)
